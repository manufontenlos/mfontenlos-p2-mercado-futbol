				    GOLD_Schema = FOOTBALL_Database{[Name="GOLD",Kind="Schema"]}[Data],
				    FACT_PLAYER_SEASON_Table = GOLD_Schema{[Name="FACT_PLAYER_SEASON",Kind="Table"]}[Data]

table FACT_PLAYER_SEASON
	lineageTag: 1d47c1f0-9694-4f34-9857-712f1741ddbe

	measure 'Minutos Jugados' = SUM(FACT_PLAYER_SEASON[MINUTES_PLAYED])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: 89797cd8-1aee-4be1-afa4-e5fa2d1de723

	measure Goles = SUM(FACT_PLAYER_SEASON[GOALS])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: a348babc-68c0-4c90-aeda-8517ca6ff8ba

	measure Asistencias = SUM(FACT_PLAYER_SEASON[ASSISTS])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: 5a0e0ea6-74db-4c1d-962b-b6acf67e57ac

	measure 'Partidos Jugados' = SUM(FACT_PLAYER_SEASON[GAMES_PLAYED])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: ca3505ec-c2a1-4fd0-913c-9cc008e5a474

	measure 'Nº Jugadores' = DISTINCTCOUNT(FACT_PLAYER_SEASON[PLAYER_ID])
		formatString: 0
		displayFolder: Medidas
		lineageTag: 95557062-985c-48ee-b860-b1ba0c63ae75

	measure 'Performance Score' =
			// Contribución de gol por 90 minutos = (goles*2 + asistencias) / (minutos/90)
			// Umbral de 450 min (~5 partidos): por debajo, en blanco, para no
			// contaminar rankings ni el score medio con muestras minúsculas.
			// Se recalcula siempre desde las columnas base (nunca se agrega la
			// columna PERFORMANCE_SCORE de la fact directamente): así funciona
			// igual de bien filtrado a una sola competición que a la temporada
			// completa de un jugador (varias filas club/competición sumadas).
			VAR Mins = [Minutos Jugados]
			VAR Num =
			    SUMX(
			        FACT_PLAYER_SEASON,
			        FACT_PLAYER_SEASON[GOALS] * 2 + FACT_PLAYER_SEASON[ASSISTS]
			    )
			RETURN
			    IF(Mins >= 450, DIVIDE(Num, Mins / 90))
		formatString: 0.00
		displayFolder: Medidas
		lineageTag: 35f046a0-f703-464b-b12d-0718b9bdfdc7

	measure 'Score Medio' =
			// Promedio del Performance Score entre los jugadores del contexto de
			// filtro actual (no un promedio de filas: un jugador con varias
			// competiciones cuenta una sola vez, con su score recompuesto).
			AVERAGEX(VALUES(DIM_PLAYER[PLAYER_ID]), [Performance Score])
		formatString: 0.00
		displayFolder: Medidas
		lineageTag: aeac24ae-03cf-4291-8ead-6f6ce6b4347a

	measure 'Valor Total de Mercado' =
			// MARKET_VALUE_EUR_SEASON_END se repite en todas las filas
			// club/competición de un mismo jugador-temporada (documentado en
			// SILVER/GOLD), así que se deduplica por jugador-temporada antes de
			// sumar; sumar la columna tal cual multiplicaría el valor por el
			// nº de competiciones de cada jugador.
			SUMX(
			    SUMMARIZE(
			        FACT_PLAYER_SEASON,
			        FACT_PLAYER_SEASON[PLAYER_ID],
			        FACT_PLAYER_SEASON[SEASON],
			        "mv", MAX(FACT_PLAYER_SEASON[MARKET_VALUE_EUR_SEASON_END])
			    ),
			    [mv]
			)
		formatString: "€"#,0
		displayFolder: Medidas
		lineageTag: 3939e5e4-e48b-4521-8ad2-9fd067e5bf4f

	measure 'Valor Medio de Mercado' =
			AVERAGEX(
			    SUMMARIZE(
			        FACT_PLAYER_SEASON,
			        FACT_PLAYER_SEASON[PLAYER_ID],
			        FACT_PLAYER_SEASON[SEASON],
			        "mv", MAX(FACT_PLAYER_SEASON[MARKET_VALUE_EUR_SEASON_END])
			    ),
			    [mv]
			)
		formatString: "€"#,0
		displayFolder: Medidas
		lineageTag: 2829645b-d681-4861-827e-46c8f9117c64

